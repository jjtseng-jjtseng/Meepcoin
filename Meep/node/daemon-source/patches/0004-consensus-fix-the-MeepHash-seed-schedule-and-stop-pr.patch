+/*
+ * MeepCoin: THE SEED-HEIGHT SCHEDULE IS CONSENSUS, AND IT IS FIXED AT COMPILE TIME.
+ *
+ * MeepCoin block proof-of-work is MeepHash-W v2, never RandomX, but it still uses this schedule:
+ * the block id at rx_seedheight(h) is the 32-byte seed the daemon feeds MeepHash as both its epoch
+ * key and its delayed-seed input (docs/BLOCK_CONSENSUS_VECTORS.md in the MeepCoin repository).
+ * Moving the schedule moves every block hash from the first epoch boundary on: a hard fork.
+ *
+ * Monero let two process-environment variables shrink both constants, a test-harness convenience
+ * for RandomX epochs. Here that meant two identical binaries could derive different seed heights,
+ * and therefore different proof-of-work, from different environments. Those reads are removed and
+ * nothing replaces them. 2048 and 64 are meepow::v2::EPOCH_LENGTH and EPOCH_DELAY.
+ */
+#define SEEDHASH_EPOCH_BLOCKS	((uint64_t)2048)	/* Must be same as BLOCKS_SYNCHRONIZING_MAX_COUNT in cryptonote_config.h */
+#define SEEDHASH_EPOCH_LAG		((uint64_t)64)
 
 uint64_t rx_seedheight(const uint64_t height) {
-  const uint64_t seedhash_epoch_lag = get_seedhash_epoch_lag();
-  const uint64_t seedhash_epoch_blocks = get_seedhash_epoch_blocks();
-  uint64_t s_height =  (height <= seedhash_epoch_blocks+seedhash_epoch_lag) ? 0 :
-                       (height - seedhash_epoch_lag - 1) & ~(seedhash_epoch_blocks-1);
+  uint64_t s_height =  (height <= SEEDHASH_EPOCH_BLOCKS+SEEDHASH_EPOCH_LAG) ? 0 :
+                       (height - SEEDHASH_EPOCH_LAG - 1) & ~(SEEDHASH_EPOCH_BLOCKS-1);
   return s_height;
 }
 
 void rx_seedheights(const uint64_t height, uint64_t *seedheight, uint64_t *nextheight) {
   *seedheight = rx_seedheight(height);
-  *nextheight = rx_seedheight(height + get_seedhash_epoch_lag());
+  *nextheight = rx_seedheight(height + SEEDHASH_EPOCH_LAG);
 }
 
 static void rx_alloc_dataset(randomx_flags flags, randomx_dataset** dataset, int ignore_env)
