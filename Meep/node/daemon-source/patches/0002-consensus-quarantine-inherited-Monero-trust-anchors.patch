diff --git a/CMakeLists.txt b/CMakeLists.txt
index e6d81ae15affcbc0e80180cbd6d1c7adf6498ac8..a8714f380f72d2f96c077756fcaf5ace99f9a35b 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -379,15 +379,25 @@ endif()
 set(CMAKE_C_FLAGS_RELEASE "-DNDEBUG ${OPT_FLAGS_RELEASE}")
 set(CMAKE_CXX_FLAGS_RELEASE "-DNDEBUG ${OPT_FLAGS_RELEASE}")
 
-# set this to 0 if per-block checkpoint needs to be disabled
-set(PER_BLOCK_CHECKPOINT 1)
-
+# MeepCoin: THE PER-BLOCK CHECKPOINT FAST PATH IS DISABLED, AND CANNOT BE CASUALLY RE-ENABLED.
+#
+# Monero compiles src/blocks/checkpoints.dat -- a blob of MONERO block hashes -- into the daemon and
+# uses it to skip verification for blocks it "already knows". Inherited by a fork, that turns a
+# foreign chain's data into a fast path that can be consulted during real-network synchronisation.
+# The blob is removed from the MeepCoin source entirely, so there is nothing to compile even if this
+# were switched on by accident.
+#
+# A cache value asking for it is a hard configuration error rather than a silent re-enable: without
+# reviewed MeepCoin checkpoint data there is nothing legitimate for it to consume.
 if(PER_BLOCK_CHECKPOINT)
-  add_definitions("-DPER_BLOCK_CHECKPOINT")
-  set(Blocks "blocks")
-else()
-  set(Blocks "")
-endif()
+  message(FATAL_ERROR
+    "PER_BLOCK_CHECKPOINT is not supported by MeepCoin.\n"
+    "The inherited src/blocks/checkpoints.dat is a MONERO checkpoint blob and has been removed from "
+    "this source tree. Enabling this path would require reviewed MeepCoin checkpoint data, which "
+    "does not exist yet. Re-run cmake without -DPER_BLOCK_CHECKPOINT.")
+endif()
+set(PER_BLOCK_CHECKPOINT 0)
+set(Blocks "")
 
 list(INSERT CMAKE_MODULE_PATH 0
   "${CMAKE_SOURCE_DIR}/cmake")
diff --git a/src/blocks/checkpoints.dat b/src/blocks/checkpoints.dat
deleted file mode 100644
