add_executable(meepcoin-genesis meepcoin_genesis.cpp)
target_link_libraries(meepcoin-genesis PRIVATE cryptonote_core cncrypto common epee
  ${Boost_PROGRAM_OPTIONS_LIBRARY} ${Boost_SYSTEM_LIBRARY} ${Boost_FILESYSTEM_LIBRARY}
  ${Boost_THREAD_LIBRARY} ${EXTRA_LIBRARIES})
set_property(TARGET meepcoin-genesis PROPERTY RUNTIME_OUTPUT_DIRECTORY
  "${CMAKE_BINARY_DIR}/bin")

